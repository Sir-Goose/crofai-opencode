{
  "name": "opencode-crofai-sidebar",
  "version": "1.0.0",
  "description": "OpenCode TUI plugin that displays CrofAI usage (requests/day, credits) in the sidebar",
  "type": "module",
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target=bun --sourcemap --entry-naming=[dir]/tui.js --external @opencode-ai/plugin --external @opentui/core --external @opentui/solid --external solid-js",
    "build:types": "cp src/index.d.ts dist/tui.d.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "crofai",
    "tui",
    "sidebar"
  ],
  "license": "MIT",
  "engines": {
    "opencode": ">=1.4.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": { "optional": true },
    "@opentui/core": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sir-Goose/crofai-opencode.git"
  }
}
